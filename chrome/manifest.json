{
  "manifest_version": 3,
  "name": "Gepetel for Chrome",
  "version": "0.1.4",
  "description": "Lets the Gepetel app on this Mac use your Chrome \u2014 in its own tab group \u2014 for what you ask it in your chat. Based on Microsoft's Playwright Extension.",
  "permissions": [
    "debugger",
    "activeTab",
    "tabs",
    "tabGroups",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "lib/background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Gepetel for Chrome",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": ""
}

{
    "name": "gepetel",
    "version": "0.0.1",
    "type": "module",
    "main": "dist/app.js",
    "scripts": {
        "test": "npm run build && node --test tests/*.test.mjs",
        "test:unit": "npm run build && node --test tests/util.test.mjs",
        "test:integration": "npm run build && node --test tests/mongo.test.mjs",
        "test:llm": "npm run build && node --test tests/llm.test.mjs",
        "build": "npx tsc",
        "gcp-build": "npx tsc",
        "start": "node dist/app.js",
        "dev": "concurrently \"npx tsc --watch\" \"nodemon --watch dist --delay 1 --exec 'node --env-file=.env dist/app.js'\""
    },
    "dependencies": {
        "@google-cloud/functions-framework": "^5.0.5",
        "axios": "^1.19.0",
        "express": "^5.2.1",
        "mongoose": "^8.24.2",
        "openai": "^7.4.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.1",
        "concurrently": "^10.0.4",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "typescript": "^7.0.2"
    }
}

{
  "name": "gepetel-agent",
  "version": "0.10.1",
  "private": true,
  "description": "Runs on the owner's Mac and lets Gepetel use it, from their 1:1 chat only.",
  "type": "module",
  "bin": {
    "gepetel-agent": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js run",
    "pair": "node dist/index.js pair",
    "test": "tsc && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.79",
    "@mozilla/readability": "^0.6.0",
    "@playwright/mcp": "0.0.83",
    "jsdom": "^30.1.2",
    "turndown": "^7.2.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}

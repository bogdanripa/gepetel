#!/bin/sh
# Playwright MCP opens its extension's connect page by launching "Chrome" with
# the page's address. Its extension id is hard-coded to Microsoft's Playwright
# Extension; Gepetel ships its own fork (chrome/ in the repo). This stands in
# for Chrome: it rewrites that one address to Gepetel's extension and hands
# everything to the real Chrome, which passes it to the Chrome already running.
# Addresses only — no other argument is touched.
from="chrome-extension://mmlmfjhmonkocbjadbfplnigmagldckm/"
to="chrome-extension://${GEPETEL_EXTENSION_ID:?}/"
for a do
    shift
    case $a in "$from"*)
        a="$to${a#"$from"}"
        # Where the agent's direct line to the extension listens (src/bridge.ts).
        if [ -n "${GEPETEL_BRIDGE_PORT:-}" ]; then a="$a&gepetelBridge=$GEPETEL_BRIDGE_PORT"; fi ;;
    esac
    set -- "$@" "$a"
done
# The profile that has the extension, by its account's email: otherwise
# Chrome opens the page in whichever profile was used last.
if [ -n "${GEPETEL_PROFILE_EMAIL:-}" ]; then
    set -- "--profile-email=$GEPETEL_PROFILE_EMAIL" "$@"
fi
# Chrome not running: start it on its own first and let it come up. Exec'd
# cold from here, it was Playwright's child — slow to start, and gone with
# Playwright's 30 s wait for the extension (2026-10-15, a job's first try
# after Chrome had been quit).
chrome="${GEPETEL_REAL_CHROME:?}"
case $chrome in */Contents/MacOS/*) bundle=1 ;; *) bundle= ;; esac
if [ -n "$bundle" ] && ! pgrep -xq "Google Chrome"; then
    app="${chrome%/Contents/MacOS/*}"
    if [ -n "${GEPETEL_PROFILE_EMAIL:-}" ]; then
        open -g -a "$app" --args "--profile-email=$GEPETEL_PROFILE_EMAIL" 2>/dev/null || true
    else
        open -g -a "$app" 2>/dev/null || true
    fi
    i=0
    while [ $i -lt 40 ] && ! pgrep -xq "Google Chrome"; do sleep 0.5; i=$((i + 1)); done
    # Its extensions start a little after the window.
    sleep 4
fi
exec "$chrome" "$@"

# Which WhatsApp gateway to use: "whapi" (default) or "wa-gateway".
WA_PROVIDER=whapi

# whapi.cloud (WA_PROVIDER=whapi)
WHAPI_TOKEN=

# wa-gateway (WA_PROVIDER=wa-gateway) — https://wa-gateway-coolify.bogdanripa.com/docs.html
# WA_GATEWAY_TOKEN is the number's token, from the gateway console.
WA_GATEWAY_URL=https://wa-gateway-coolify.bogdanripa.com/api
WA_GATEWAY_TOKEN=
WA_GATEWAY_PHONE_NUMBER_ID=gepetel

OPENAI_API_KEY=
GEPETEL_DATABASE_URL=
PAYMENT_SECRET=
PUBLIC_API_KEY=

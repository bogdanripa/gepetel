# Which WhatsApp gateway to use: "whapi" (default) or "wa-gateway".
WA_PROVIDER=wa-gateway

# whapi.cloud (WA_PROVIDER=whapi)
WHAPI_TOKEN=

# wa-gateway (WA_PROVIDER=wa-gateway) — https://wa-gateway-coolify.bogdanripa.com/docs.html
# WA_GATEWAY_TOKEN is the number's token, from the gateway console.
WA_GATEWAY_URL=https://wa-gateway-coolify.bogdanripa.com/api
WA_GATEWAY_TOKEN=
WA_GATEWAY_PHONE_NUMBER_ID=gepetel

OPENAI_API_KEY=
GEPETEL_DATABASE_URL=
PAYMENT_SECRET=
PUBLIC_API_KEY=

# Operator notifications (optional — left empty, they're simply skipped).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phone calls (voice.ts) — off unless VOICE_ENABLED=1.
VOICE_ENABLED=
OPENAI_WEBHOOK_SECRET=
# Who may call: comma list of numbers (or * for anyone with a 1:1 chat). Empty = nobody.
VOICE_CALLERS=
# Phone model: gpt-live-1 (default, voice ballad) or a Realtime model such as gpt-realtime-2.1. VOICE_VOICE overrides the voice.
VOICE_MODEL=
VOICE_VOICE=
# Calling back after a WhatsApp call (Twilio rings them from VOICE_CALLER_ID, a verified caller ID).
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
VOICE_CALLER_ID=
OPENAI_PROJECT_ID=
VOICE_CALLBACK_SECRET=
